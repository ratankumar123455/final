# Postgres connection string. For local dev, point this at a local Postgres
# instance or a free dev database (e.g. Neon, Supabase). In production on
# Vercel, use their Postgres storage integration to auto-populate this.
DATABASE_URL="postgresql://user:password@localhost:5432/udhaarlog"

# Used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# WhatsApp Business API provider (e.g. Gupshup, Twilio, WATI).
# Leave blank to run in mock mode (reminders are logged to the console instead of sent).
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
